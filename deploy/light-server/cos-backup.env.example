# Install as /etc/football-predict/cos-backup.env with root:root ownership and mode 0600.
# Use a dedicated CAM sub-user restricted to this bucket and the postgres/ prefix.
COS_SECRET_ID=replace-with-dedicated-secret-id
COS_SECRET_KEY=replace-with-dedicated-secret-key
COS_SESSION_TOKEN=
FOOTBALL_COS_BUCKET=football-prod-backup-1322029790
FOOTBALL_COS_REGION=ap-guangzhou
FOOTBALL_COS_PREFIX=postgres

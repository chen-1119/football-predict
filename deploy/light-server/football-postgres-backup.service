[Unit]
Description=Football Predict PostgreSQL verified backup
After=postgresql.service
Requires=postgresql.service
OnSuccess=football-postgres-cos-upload.service

[Service]
Type=oneshot
User=postgres
Group=football
Environment=PGHOST=/var/run/postgresql
Environment=PGDATABASE=football
Environment=FOOTBALL_POSTGRES_BACKUP_DIR=/var/lib/football-predict/postgres-backups
Environment=FOOTBALL_POSTGRES_BACKUP_RETENTION_DAYS=14
ExecStart=/usr/local/sbin/football-postgres-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/usr/bin /usr/lib /var/run/postgresql
ReadWritePaths=/var/lib/football-predict/postgres-backups
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Unit]
Description=Football Predict server cleanup
After=football-predict.service

[Service]
Type=oneshot
WorkingDirectory=/opt/football-predict
Environment=PATH=/opt/node-v22.22.1/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_HOME=/opt/node-v22.22.1
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=1536
Environment=SERVER_STORE_DIR=/var/lib/football-predict
Environment=SERVER_CLEANUP_STORE_DIR=/var/lib/football-predict
Environment=SNAPSHOT_RETENTION_DAYS=3
Environment=SERVER_CLEANUP_APPLY=1
Environment=SERVER_CLEANUP_APP_BACKUPS=0
Environment=SERVER_CLEANUP_APP_ARTIFACTS=0
Environment=SERVER_CLEANUP_TMP_ARTIFACTS=0
Environment=SERVER_CLEANUP_SYSTEM_LOGS=0
ExecStart=/opt/node-v22.22.1/bin/node /opt/football-predict/scripts/cleanupServerArtifacts.cjs
User=football
Group=football
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
UMask=0027
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/node-v22.22.1
ReadWritePaths=/var/lib/football-predict
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

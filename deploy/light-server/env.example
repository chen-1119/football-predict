NODE_ENV=production
NODE_HOME=/opt/node-v22.22.1
NODE_OPTIONS=--max-old-space-size=1536
MIRROR_PUBLISHED_DATA_TO_DIST=0
WRITE_LEGACY_STATIC_PAYLOADS=0
PATH=/opt/node-v22.22.1/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOST=127.0.0.1
PORT=8788
SHUTDOWN_GRACE_MS=4000

# Public website data API. Keep "/api/v1" when Node serves frontend and API together.
PUBLIC_DATA_API_BASE=/api/v1
PUBLIC_DATA_API_V1_BASE=/api/v1
PAGE_POLL_SECONDS=15

# Server-side data refresh. 300 seconds = 5 minutes.
# The cloud server owns sync processing, SQLite export, model catch-up, and API
# reads. These labels do not prove upstream source redundancy: runtime health
# reports a watch when direct/proxy egress is unverified and fewer than two
# trusted collectors are evidenced.
PRODUCTION_DATA_MODE=server-primary
SERVER_DATA_PRIMARY=1
LOCAL_DATA_PUSH_REQUIRED=0
CLOUD_SYNC_REQUIRED=0
SPORTTERY_RELAY_REQUIRED=0
ENABLE_SYNC_CRON=0
SYNC_INTERVAL_SECONDS=300
HOT_SYNC_INTERVAL_SECONDS=90
# Once a match is past its immutable decision cutoff (including live,
# pending-result and recent-kickoff states), keep full sync at the base
# cadence. The one-second official-result watcher remains independent, while
# pre-cutoff market capture stays on the 90s lane.
POST_DEADLINE_HOT_SYNC_INTERVAL_SECONDS=300
HOT_SYNC_WINDOW_MINUTES=120
# Use the hot refresh cadence before the immutable official decision cutoff,
# even when kickoff is still many hours away.
CANDIDATE_DEADLINE_HOT_WINDOW_MINUTES=120
SYNC_WORKER_MIN_IDLE_SECONDS=10
# Publish official data on every cadence, but run network enrichments, model
# backtests and any resulting second publication at most once per 15 minutes.
SYNC_WORKER_SLOW_PHASE_MIN_INTERVAL_MINUTES=60
# A signed release request gets a bounded wait through a transient fast-result
# watcher lock and retries an incomplete first cycle without sleeping 90/300s.
SYNC_WORKER_RELEASE_INITIAL_LOCK_WAIT_MS=60000
SYNC_WORKER_RELEASE_RETRY_MS=5000
# Protect the mkdir-to-lock.json write window, then reclaim ownerless lock dirs.
SYNC_LOCK_METADATA_GRACE_SECONDS=10
SNAPSHOT_RETENTION_DAYS=2
SNAPSHOT_RETENTION_MAX_FILES=96
SERVER_STORE_DIR=/var/lib/football-predict
CURRENT_MATCH_SOURCE=sqlite
CURRENT_MATCH_DB_MAX_STALE_SECONDS=30
SQLITE_READ_STALE_GRACE_SECONDS=600
V1_MATCH_DETAIL_CACHE_TTL_MS=30000
# Atomic current-to-result bridge capacity. The server enforces 64..256 and
# expands to the latest fast-publication batch size so a whole slate closes at once.
CURRENT_TRANSITION_ROW_LIMIT=16
ENABLE_FULL_HISTORY_FILE_FALLBACK=0
DATASTORE_READ_SOURCE=sqlite
DATASTORE_SQLITE_PATH=/var/lib/football-predict/football.db
DATASTORE_HISTORY_SNAPSHOT_RETENTION_DAYS=14
DATASTORE_STORE_FULL_MATCH_SNAPSHOTS=0
DATASTORE_ODDS_HISTORY_RETENTION_DAYS=30
DATASTORE_ODDS_HISTORY_RECENT_ROWS=12000
DATASTORE_COMPACT_ON_SYNC=1
DATASTORE_COMPACT_INTERVAL_MINUTES=60
DATASTORE_COMPACT_RETENTION_DAYS=14
DATASTORE_COMPACT_MAX_ROWS=150000
SERVER_CLEANUP_CURRENT_SNAPSHOT_RETENTION_DAYS=2
SERVER_CLEANUP_CURRENT_SNAPSHOT_KEEP=96
SERVER_CLEANUP_CURRENT_SNAPSHOT_UNCOMPRESSED_KEEP=24
SERVER_CLEANUP_CURRENT_SNAPSHOT_COMPRESS_AGE_HOURS=12
SERVER_CLEANUP_APP_ARTIFACTS=1
SERVER_CLEANUP_DATA_BACKUP_COMPRESS_DAYS=1
SERVER_CLEANUP_SQLITE_BACKUP_RETENTION_DAYS=7
SERVER_CLEANUP_SQLITE_BACKUP_KEEP=3
SERVER_CLEANUP_SQLITE_BACKUP_COMPRESS_DAYS=1
SQLITE_BUSY_TIMEOUT_MS=60000
SQLITE_EXPORT_ATTEMPTS=3
SQLITE_EXPORT_RETRY_DELAY_MS=5000
RELEASE_LIVE_SQLITE_PREBUILD_MIN_MEM_AVAILABLE_MIB=3072
RELEASE_LIVE_SQLITE_PREBUILD_MAX_APP_MEMORY_CURRENT_MIB=640
RELEASE_LIVE_SQLITE_PREBUILD_MAX_APP_WORKING_SET_MIB=512
ENABLE_MODEL_BACKTEST_ON_SYNC=1
MODEL_BACKTEST_ON_SYNC_MIN_INTERVAL_MINUTES=120
ENABLE_CANDIDATE_PROSPECTIVE_DEADLINE_CAPTURE=1
CANDIDATE_PROSPECTIVE_CAPTURE_INTERVAL_SECONDS=30
CANDIDATE_PROSPECTIVE_CAPTURE_TIMEOUT_MS=100000
CANDIDATE_PROSPECTIVE_CAPTURE_RECOVERY_BUDGET_MS=55000
# Leave blank. If an active trial already has evidence, model:backtest prints
# the exact hash-bound value required for an intentional gate-spec reset.
CANDIDATE_PROSPECTIVE_GATE_RESET_AUTHORIZATION=
MODEL_BACKTEST_SQLITE_ODDS_LIMIT=120000
MODEL_BACKTEST_SQLITE_PREDICTION_LIMIT=50000
MODEL_BACKTEST_SNAPSHOTS_PER_MATCH=6
MODEL_EVALUATION_SQLITE_COVERAGE_MIN=0.95
MODEL_BACKTEST_SQLITE_COVERAGE_TRIGGER_RATIO=0.98
ENABLE_MODEL_STRATEGY_ON_SYNC=0
ENABLE_SQLITE_EXPORT=1
ENABLE_500_SYNC=1
ENABLE_500_DETAILS_SYNC=1
ENABLE_UEFA_OFFICIAL_RESULTS_SYNC=1
UEFA_RESULT_LOOKBACK_HOURS=120
UEFA_RESULT_TIMEOUT_MS=20000
ENABLE_OFFICIAL_CLUB_RESULTS_SYNC=1
FIVE_HUNDRED_DETAILS_MAX_MATCHES=24
FIVE_HUNDRED_DETAILS_REFRESH_MINUTES=180
FIVE_HUNDRED_DETAILS_NEAR_REFRESH_MINUTES=60
FIVE_HUNDRED_DETAILS_URGENT_REFRESH_MINUTES=20
FIVE_HUNDRED_DETAILS_TIMEOUT_SECONDS=10
FIVE_HUNDRED_DETAILS_MAX_ERRORS=3
ENABLE_WEATHER_SYNC=1
WEATHER_PROVIDER=open-meteo
WEATHER_LOOKAHEAD_DAYS=10
WEATHER_MAX_MATCHES=32
WEATHER_TIMEOUT_SECONDS=12
WEATHER_ENABLE_THESPORTSDB_VENUE_DISCOVERY=1
WEATHER_VENUE_DISCOVERY_MAX_TEAMS=4
WEATHER_VENUE_DISCOVERY_RETRY_MINUTES=1440
THESPORTSDB_API_KEY=123
# Explicit opt-in shadow lane. Keep the key only in /etc/football-predict/env;
# API-Football never becomes Sporttery identity/odds/result/settlement or formal
# recommendation authority.
ENABLE_API_FOOTBALL_SYNC=0
API_FOOTBALL_SYNC_MODE=shadow-enrichment
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=
API_FOOTBALL_MAX_CALLS_PER_SYNC=12
API_FOOTBALL_LOOKAHEAD_DAYS=7
# A provider-level suspension is persistent account state, not a normal
# request failure. Probe the same credential at most once per day; replacing
# the key clears this cooldown and triggers an immediate /status preflight.
API_FOOTBALL_SUSPENSION_PROBE_MINUTES=1440
API_FOOTBALL_INJURIES_ENABLED=1
API_FOOTBALL_INJURY_REFRESH_MINUTES=360
API_FOOTBALL_ODDS_ENABLED=0
API_FOOTBALL_ODDS_REFRESH_MINUTES=180
API_FOOTBALL_LINEUPS_ENABLED=1
API_FOOTBALL_LINEUP_REFRESH_MINUTES=20
API_FOOTBALL_LIVE_SCORE_ENABLED=1
API_FOOTBALL_LIVE_SCORE_REFRESH_SECONDS=30
API_FOOTBALL_LIVE_SCORE_PRE_KICKOFF_MINUTES=10
API_FOOTBALL_LIVE_SCORE_POST_KICKOFF_MINUTES=210
API_FOOTBALL_LIVE_SCORE_CACHE_MAX_SECONDS=300
ENABLE_FREE_FOOTBALL_SYNC=1
ENABLE_K_LEAGUE_OFFICIAL_STANDINGS_SYNC=1
ENABLE_PREMATCH_SIGNALS_SYNC=1
REQUIRE_EXTERNAL_SIGNALS=1
REQUIRE_PREMATCH_SIGNALS=0
SOURCE_MAX_AGE_MINUTES=20
SOURCE_MIN_500_ROWS=1
SOURCE_MIN_500_MAPPED=1
SOURCE_MIN_PREMATCH_ROWS=1
SOURCE_MIN_CURRENT_MATCHES=1
SOURCE_MIN_EXTERNAL_COVERAGE=0.50
SOURCE_STRICT_PRIMARY_HEALTH=0
V1_HEALTH_STALE_AFTER_SECONDS=600
V1_FALLBACK_MAX_STALE_SECONDS=3600
MODEL_RELIABILITY_MIN_ROWS=30

# Existing Sporttery sync tuning.
SKIP_SPORTTERY_FETCH=0
SKIP_SPORTTERY_DIRECT_FETCH=1
SPORTTERY_DIRECT_FETCH=0
# Optional mainland egress proxy for China Sporttery. Supports HTTP(S) and SOCKS proxies accepted by curl.
# Preferred: SPORTTERY_OUTBOUND_PROXY=socks5h://user:password@mainland-proxy.example.com:1080
# Alternative: SPORTTERY_OUTBOUND_PROXY=https://user:password@mainland-proxy.example.com:8443
SPORTTERY_OUTBOUND_PROXY=
# Optional Sporttery relay snapshot produced by `npm run sync:sporttery-snapshot`
# on a mainland collector, then copied to this server. Mode: prefer, fallback, off.
SPORTTERY_RELAY_MODE=prefer
# Complete single-cycle result+all archive snapshot. Fast uploads never modify it.
SPORTTERY_RELAY_SNAPSHOT=/var/lib/football-predict/sporttery-relay-snapshot.json
# Independently replaced current/calculator plus optional result-page-1 snapshot.
SPORTTERY_RELAY_FAST_LANE_SNAPSHOT=/var/lib/football-predict/sporttery-relay-fast-lane.json
# Independently signed collector evidence is retained separately from the
# serving relay files and can only support decisions when received before cutoff.
SPORTTERY_COLLECTOR_EVIDENCE_STORE_PATH=/var/lib/football-predict/sporttery-collector-evidence.json
# Existing zero-cost independent collector. The URL is public; keep the bearer
# pull token only in /etc/football-predict/env (root:football, mode 0640).
SPORTTERY_CLOUDFLARE_EVIDENCE_URL=https://football-predict-sync-trigger.doki981119.workers.dev/api/sporttery-evidence
SPORTTERY_CLOUDFLARE_PULL_TOKEN=
SPORTTERY_CLOUDFLARE_UPLOAD_TRANSPORT=local-http
SPORTTERY_CLOUDFLARE_LOCAL_UPLOAD_URL=http://127.0.0.1:8788/api/admin/sporttery-collector-evidence
SPORTTERY_CLOUDFLARE_TIMEOUT_MS=30000
SPORTTERY_CLOUDFLARE_EVIDENCE_INTERVAL_SECONDS=300
# Optional second signed official-market collector executed by the new server.
# Keep the private key outside the immutable release tree and readable only by
# the football service account/group.
SPORTTERY_SERVER_DIRECT_COLLECTOR_PRIVATE_KEY_PATH=
SPORTTERY_SERVER_DIRECT_COLLECTOR_KEY_ID=
SPORTTERY_SERVER_DIRECT_COLLECTOR_KEY_FINGERPRINT=
SPORTTERY_SERVER_DIRECT_COLLECTOR_TIMEOUT_MS=30000
SPORTTERY_SERVER_DIRECT_RELAY_UPLOAD_URL=http://127.0.0.1:8788/api/admin/sporttery-relay-fast-lane?runSync=0
# Public Ed25519 trust registry used to verify mainland collector attestations.
# The private signing key must never be copied to the server or release bundle.
SPORTTERY_COLLECTOR_TRUST_REGISTRY_PATH=/opt/football-predict/deploy/light-server/collector-trust-registry.json
SPORTTERY_RELAY_MAX_AGE_MINUTES=20
# Production SQLite reads enable this independent result watcher by default.
# It detects relay file changes every second and publishes trusted finals without
# waiting for the heavier full synchronization cycle. Set to 0 only for rollback.
RELAY_FAST_WATCHER_ENABLED=1
RELAY_FAST_WATCHER_POLL_MS=1000
RELAY_FAST_WATCHER_TIMEOUT_MS=8000
TRUSTED_MAX_FUTURE_SKEW_SECONDS=300
SYNC_META_COMMIT_LOCK_WAIT_MS=30000
SYNC_META_COMMIT_LOCK_STALE_MS=120000
# Runtime monitor must fail closed if a production release omits or stalls the
# fast-result watcher, even when ordinary API response times remain healthy.
RUNTIME_MONITOR_REQUIRE_FAST_RESULT_WATCHER=1
RUNTIME_MONITOR_FAST_RESULT_WATCHER_MAX_POLL_MS=5000
RUNTIME_MONITOR_FAST_RESULT_WATCHER_MAX_CHECK_AGE_SECONDS=30
# Paged result/history is a slower lane than current/calculator. Its own
# endpoint timestamps are authoritative; a fresh current lane cannot refresh it.
SPORTTERY_RELAY_HISTORY_MAX_AGE_MINUTES=180
SPORTTERY_RELAY_STALE_FALLBACK_MAX_AGE_MINUTES=60
SPORTTERY_RELAY_BACKOFF_FAILURES=3
SPORTTERY_RELAY_BACKOFF_BASE_MINUTES=15
SPORTTERY_RELAY_BACKOFF_MAX_MINUTES=60
# When the circuit is healthy, refresh current/calculator on the task cadence
# but run the heavier paged/full collection at most once per hour.
SPORTTERY_RELAY_FULL_INTERVAL_MINUTES=60
# Retain the last real paged snapshot for composition while marking its lane
# stale independently; a composite snapshot never replaces this last-good file.
SPORTTERY_RELAY_TRUSTED_FULL_RETENTION_MAX_AGE_MINUTES=10080
# Keep the lightweight current/calculator lane running during full-lane backoff
# so C-end current lists stay fresh even when paged/full Sporttery endpoints are blocked.
SPORTTERY_RELAY_BACKOFF_CURRENT_COLLECT=1
# Repeated official WAF responses keep a bounded current/calculator recovery
# probe. Consecutive failures back off 10 -> 20 -> 40 -> 60 minutes so the
# one-minute task cannot keep extending a provider-side WAF window.
SPORTTERY_RELAY_WAF_BACKOFF_CURRENT_COLLECT=1
SPORTTERY_RELAY_WAF_CURRENT_PROBE_MINUTES=10
SPORTTERY_RELAY_WAF_CURRENT_PROBE_MAX_MINUTES=60
# A valid ACTIVE candidate heartbeat can tighten only the current/calculator
# WAF probe cadence as the nearest non-excluded decision deadline approaches.
# Normal collection remains 10 -> 20 -> 40 -> 60 minutes outside this window.
SPORTTERY_RELAY_DEADLINE_URGENT_WINDOW_MINUTES=120
SPORTTERY_RELAY_WAF_URGENT_PROBE_MAX_MINUTES=10
SPORTTERY_RELAY_DEADLINE_QUERY_TIMEOUT_MS=10000
# Partial current-only snapshots are evidence for the collector state, but should
# not overwrite the server relay snapshot unless an operator explicitly accepts
# the reduced coverage.
SPORTTERY_RELAY_ALLOW_PARTIAL_LIVE_UPLOAD=0
SPORTTERY_RELAY_UPLOAD_MAX_BYTES=26214400
SPORTTERY_RELAY_FAST_LANE_UPLOAD_MAX_BYTES=8388608
SPORTTERY_RELAY_MAX_CONSECUTIVE_COLLECT_FAILURES=3
# Collector-side trusted snapshot floor. Tiny current-only snapshots may keep the
# live list fresh, but they are not treated as complete trusted Sporttery data.
SPORTTERY_RELAY_MIN_TRUSTED_ROWS=100
SPORTTERY_RELAY_MIN_TRUSTED_ENDPOINTS=2
# A direct/proxy path counts as independent only after a recent successful sync
# or a healthy egress probe inside this evidence window.
SPORTTERY_EGRESS_PROOF_MAX_AGE_MINUTES=20

# Per-step watchdogs keep a hung upstream or child process from holding the
# single-flight sync lock forever. Values are milliseconds.
SYNC_WORKER_COMMAND_TIMEOUT_MS=900000
SYNC_WORKER_ENRICHMENT_TIMEOUT_MS=180000
SYNC_WORKER_SYNC_TIMEOUT_MS=300000
SYNC_WORKER_VALIDATION_TIMEOUT_MS=120000
SYNC_WORKER_SQLITE_TIMEOUT_MS=300000
SYNC_WORKER_MODEL_TIMEOUT_MS=900000
# The worker releases the global publication permit during slow enrichment and
# model computation, then waits this long to reacquire it for generation/SQLite
# commits. This lets the one-second result watcher publish between write phases.
SYNC_WORKER_PHASE_LOCK_WAIT_MS=30000

# PostgreSQL migration target. Keep unset while SQLite remains authoritative.
# Provision this on a separate managed service or attached data volume; do not
# duplicate the 2+ GiB SQLite file onto the production root disk.
# Local peer-authenticated PostgreSQL on the Ubuntu production host. For a
# managed remote database, use a credentialed URL and verify-full TLS instead.
# FOOTBALL_POSTGRES_URL=postgresql:///football?host=%2Fvar%2Frun%2Fpostgresql
FOOTBALL_POSTGRES_SSL_MODE=disable
FOOTBALL_POSTGRES_POOL_MIN=1
FOOTBALL_POSTGRES_POOL_MAX=8
FOOTBALL_POSTGRES_CONNECT_TIMEOUT_MS=8000
FOOTBALL_POSTGRES_QUERY_TIMEOUT_MS=30000
# Future cutover phases: disabled -> shadow-write -> shadow-read -> primary.
FOOTBALL_POSTGRES_MODE=disabled
# Optional mainland collector HTTPS push. This is disaster recovery or a
# dedicated collector path, not the production primary path and not a local PC
# requirement.
# CLOUD_SYNC_REQUIRE_LOCAL_AUTOMATION=0
# FOOTBALL_CLOUD_API_BASE=https://your-server
# FOOTBALL_CLOUD_ADMIN_TOKEN=<same as ADMIN_TOKEN>
# FOOTBALL_CLOUD_API_UPLOAD=1
# FOOTBALL_CLOUD_RELAY_RUN_SYNC=0
MATCH_WINDOW_BACK_DAYS=365
# Keep unresolved/live fixtures in the C-end current list for at most 48 hours
# after kickoff. Older rows remain unresolved in the private runtime archive.
CURRENT_UNSETTLED_RETENTION_HOURS=48
SPORTTERY_PAGE_DEPTH=120
ODDS_HISTORY_RETENTION_DAYS=14
ODDS_HISTORY_MAX_ROWS=12000
ODDS_HISTORY_BUCKET_MINUTES=5

# Free/open research gateway. This discovers public metadata and legal open
# copies only; it never reuses browser sessions and never bypasses paywalls.
ENABLE_OPEN_RESEARCH_SYNC=1
ENABLE_WEB_CONSENSUS_SYNC=1
WEB_CONSENSUS_REFRESH_MINUTES=30
OPEN_RESEARCH_MAX_MATCHES=4
OPEN_RESEARCH_MAX_RESULTS=8
OPEN_RESEARCH_TIMEOUT_MS=7000
OPEN_RESEARCH_CACHE_TTL_MINUTES=30
OPEN_RESEARCH_REFRESH_MINUTES=30
OPEN_RESEARCH_MAX_CONCURRENCY=2
OPEN_RESEARCH_RATE_BURST=3
OPEN_RESEARCH_RATE_REFILL_MS=5000
# Optional. Crossref works without this; a contact email enters its polite pool.
OPEN_RESEARCH_CONTACT_EMAIL=
# Public HTTPS site/contact URL used in Wikimedia API identification.
OPEN_RESEARCH_CONTACT_URL=https://your-domain.example/
# Optional and required only when DOI-to-open-copy lookup via Unpaywall is used.
OPEN_RESEARCH_UNPAYWALL_EMAIL=
# Optional future adapter. Use HTTPS, or HTTP only on this server's loopback.
OPEN_RESEARCH_SEARXNG_BASE_URL=

# GPT relay predictions. Turn this on after filling relay settings.
ENABLE_GPT_CRON=0
GPT_INTERVAL_SECONDS=900
GPT_PREDICT_LIMIT=8
GPT_RELAY_BASE_URL=https://your-relay.example.com
GPT_RELAY_CHAT_PATH=/v1/chat/completions
GPT_RELAY_API_KEY=replace-with-relay-key
# Optional explanation/risk-review model only. Provision gpt-5.6 explicitly when the relay account has access.
GPT_MODEL=
GPT_TEMPERATURE=0.2

# Required in production for /api/admin/sync and /api/admin/predict.
ADMIN_TOKEN=replace-with-a-long-random-token
ALLOW_LOCAL_ADMIN=0

# Access-code gate for recommendation content. 21600 seconds = 6 hours.
ACCESS_CODE_ADMIN_TOKEN=replace-with-fixed-code-admin-token
ACCESS_CODE_TTL_SECONDS=21600
ACCESS_CODE_SECRET=replace-with-another-long-random-secret

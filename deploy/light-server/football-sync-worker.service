[Unit]
Description=Football Predict sync worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/football-predict
EnvironmentFile=/opt/football-predict/deploy/light-server/env
Environment=SYNC_WORKER_LOOP=1
Environment=DATASTORE_READ_SOURCE=sqlite
Environment=ENABLE_SQLITE_EXPORT=1
ExecStart=/usr/bin/node /opt/football-predict/scripts/runSyncWorker.cjs
Restart=always
RestartSec=10
User=football
Group=football
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

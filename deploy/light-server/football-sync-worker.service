[Unit]
Description=Football Predict sync worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/football-predict
EnvironmentFile=/etc/football-predict/env
Environment=SPORTTERY_COLLECTOR_TRUST_REGISTRY_PATH=/opt/football-predict/deploy/light-server/collector-trust-registry.json
Environment=SYNC_WORKER_LOOP=1
Environment=ENABLE_SQLITE_EXPORT=1
Environment="NODE_OPTIONS=--max-old-space-size=768 --expose-gc"
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/node-v22.22.1/bin/node /opt/football-predict/scripts/runSyncWorker.cjs --loop
Restart=on-failure
RestartSec=10
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
OOMScoreAdjust=500
MemoryHigh=3G
MemoryMax=4G
MemorySwapMax=1G
User=football
Group=football
NoNewPrivileges=true
UMask=0027
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/football-predict
ReadWritePaths=/opt/football-predict/public
ReadWritePaths=/opt/football-predict/server-data
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target

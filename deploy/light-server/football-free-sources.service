[Unit]
Description=Independent free football facts collector
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=football
Group=football
WorkingDirectory=/opt/football-predict
EnvironmentFile=/etc/football-predict/env
ExecStart=/opt/node-v22.22.1/bin/node /opt/football-predict/collectors/football-sources/run.cjs
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0027

# Review and install through the signed release transaction. The old /api/v1,
# authentication and SPA routes stay available during the first migration.
location ^~ /api/v2/ {
    proxy_pass http://127.0.0.1:8790;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 3s;
    proxy_read_timeout 20s;
    add_header Cache-Control "no-store" always;
}
# First SSR rollout uses a separate reviewed virtual host pointing to port 3100.
# Do not replace all current website routes by copying this example in place.

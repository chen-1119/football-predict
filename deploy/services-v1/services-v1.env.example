# Set by the reviewed cutover. Never run the old and new official worker together.
FOOTBALL_SERVICE_LAYOUT=separated-v1
SERVER_STORE_DIR=/var/lib/football-predict/server-data
DATA_STORE_DIR=/var/lib/football-predict/server-data
DATA_GENERATION_PUBLIC_DATA_DIR=/var/lib/football-predict/public/data
SPORTTERY_COLLECTOR_TRUST_REGISTRY_PATH=/etc/football-predict/collector-trust-registry.json
# The existing publisher/settlement services are retired only when their
# corresponding new service is activated. No new model or probability settings.

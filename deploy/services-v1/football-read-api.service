[Unit]
Description=Football independent committed PostgreSQL read API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=football
Group=football
WorkingDirectory=/opt/football-services/read-api/current
EnvironmentFile=/etc/football-predict/env
Environment=READ_API_PORT=8790
Environment=READ_API_HOST=127.0.0.1
ExecStart=/opt/node-v22.22.1/bin/node services/read-api/server.cjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target

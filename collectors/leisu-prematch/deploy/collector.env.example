# Dedicated collector configuration; use systemd EnvironmentFile syntax.
# Keep this file root:leisu-collector, mode 0640. Never commit real credentials.
# Do not source or copy the football website's full production environment.
LEISU_ENABLED=0
LEISU_ACCESS_VALIDATED=0
LEISU_STATE_DIR=/var/lib/football-leisu-collector
LEISU_PROFILE_DIR=/var/lib/football-leisu-collector/browser
LEISU_MAPPINGS_FILE=/etc/football-leisu-collector/mappings.json
LEISU_TEAM_ALIASES_FILE=/etc/football-leisu-collector/team-aliases.json
# Verified from validation/leisu-league-samples.json (2026-09-12); EPL only.
# Add other competition URLs only after checking their real official pages.
LEISU_LEAGUE_URLS_JSON='["https://www.leisu.com/data/zuqiu/comp-82"]'
LEISU_OUTPUT_FILE=/var/lib/football-leisu-collector/latest-evidence.json
LEISU_HEADLESS=true
LEISU_FIXTURE_MAX_AGE_MINUTES=60
LEISU_MAX_PAGES_PER_RUN=12
LEISU_MAX_RUN_SECONDS=480

# Fill with a real, narrowly authorized READ-ONLY football database connection.
# Empty means not configured; these are not working login credentials.
LEISU_FIXTURE_DATABASE_URL=

# Fill with a real connection restricted to writes in leisu_prematch only.
LEISU_DATABASE_URL=

# Playwright runtime setting: separate from any existing website browser cache.
PLAYWRIGHT_BROWSERS_PATH=/var/lib/football-leisu-collector/playwright
